# Copy this file to .env.local and fill in real values.

# Supabase project — Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, never expose to the browser. Needed later for admin-only
# operations (e.g. inviting users) that bypass row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Where the "Shop" link should redirect once the Shopify store is live.
NEXT_PUBLIC_SHOP_URL=

# api-football.com free API key (dashboard.api-football.com after signup).
# Server-only — used by the "Sync from API-Football" buttons in
# /admin/fixtures. See README for how to find your league/team IDs.
API_FOOTBALL_KEY=
